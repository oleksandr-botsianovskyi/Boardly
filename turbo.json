{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "cache": false
    },
    "lint": { "dependsOn": ["^lint"] },
    "test": {},
    "test:cov": {
      "outputs": ["coverage/**"]
    },
    "test:e2e": {}
  }
}
